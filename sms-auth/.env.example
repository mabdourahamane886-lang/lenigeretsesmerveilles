# Le dashboard Supabase (auth e-mail + persistance)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# Clé aléatoire secrète pour HMAC des codes OTP (minimum 32 caractères).
OTP_PEPPER=REPLACE_WITH_LONG_RANDOM_SERVER_SIDE_VALUE_32_CHARS_MIN

# Meta / WhatsApp Cloud API — compte WhatsApp Business approuvé
WHATSAPP_ACCESS_TOKEN=REPLACE_ME_SERVER_ONLY
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_AUTH_TEMPLATE=authentication_copy_code
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_RANDOM_WEBHOOK_VERIFY_STRING
META_APP_SECRET=REPLACE_ME_SERVER_ONLY

# URL réelle utilisée dans les paramètres du compte
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable after configuring Google in Supabase Auth.
NEXT_PUBLIC_SMS_AUTH_GOOGLE_ENABLED=false
