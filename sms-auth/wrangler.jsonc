{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sms-auth",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
